# MongoDB Connection URI (Atlas or Local)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ebill?retryWrites=true&w=majority"

# Razorpay Credentials (Test Mode)
# Get your API keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Razorpay Webhook Secret
# Set this secret in Razorpay Dashboard: Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Public Key ID for Frontend Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
